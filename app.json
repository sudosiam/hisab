{
  "expo": {
    "name": "Hisab",
    "slug": "hisab",
    "version": "10.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hisab",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F5F9"
    },
    "backgroundColor": "#F3F5F9",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisab.app",
      "buildNumber": "31"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F5F9",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.hisab.app",
      "versionCode": 31,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0D10",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-system-ui",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-asset",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75b78ed4-f0be-44a0-97a9-35d194b78a34"
      }
    },
    "owner": "biswajit73838",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/75b78ed4-f0be-44a0-97a9-35d194b78a34",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
