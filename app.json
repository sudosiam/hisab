{
  "expo": {
    "name": "Hisab",
    "slug": "hisab",
    "version": "10.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hisab",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1731"
    },
    "backgroundColor": "#0B1731",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisab.app",
      "buildNumber": "37"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1731",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.hisab.app",
      "versionCode": 37,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1731",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-system-ui",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-asset",
      "expo-background-task",
      [
        "react-native-share",
        {
          "ios": [
            "whatsapp",
            "whatsapp-business"
          ],
          "android": [
            "com.whatsapp",
            "com.whatsapp.w4b"
          ],
          "enableBase64ShareAndroid": false
        }
      ],
      "expo-build-properties",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75b78ed4-f0be-44a0-97a9-35d194b78a34"
      }
    },
    "owner": "biswajit73838",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/75b78ed4-f0be-44a0-97a9-35d194b78a34",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
