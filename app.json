{
  "expo": {
    "name": "Hisab",
    "slug": "hisab",
    "version": "11.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hisab",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "backgroundColor": "#000000",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisab.app",
      "buildNumber": "43"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.hisab.app",
      "versionCode": 43,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-system-ui",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-asset",
      "expo-background-task",
      [
        "react-native-share",
        {
          "ios": [
            "whatsapp",
            "whatsapp-business"
          ],
          "android": [
            "com.whatsapp",
            "com.whatsapp.w4b"
          ],
          "enableBase64ShareAndroid": false
        }
      ],
      "expo-build-properties",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3B5B84",
          "defaultChannel": "hisab-overdue"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "HisabOverview",
              "label": "Hisab Overview",
              "description": "Net profit, cash, receivable and payable",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/overview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "HisabPeriod",
              "label": "Hisab Period",
              "description": "Revenue, purchases, expenses and net profit",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/period.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "HisabTrend",
              "label": "Hisab Daily Trend",
              "description": "Daily sales chart for the current month",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "previewImage": "./assets/widget-preview/trend.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "HisabActions",
              "label": "Hisab Quick Actions",
              "description": "New sale and payment shortcuts",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "previewImage": "./assets/widget-preview/actions.png",
              "updatePeriodMillis": 0,
              "resizeMode": "horizontal"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75b78ed4-f0be-44a0-97a9-35d194b78a34"
      }
    },
    "owner": "biswajit73838",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/75b78ed4-f0be-44a0-97a9-35d194b78a34",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
