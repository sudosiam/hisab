# Copy to `.env` for local builds. Values are public (anon key) but must match your project.
# For EAS: set the same names as project secrets / env vars on preview + production profiles.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Personal single-user lock: only this email may sign in / create a cloud-backup account.
# Recommended for private builds. Leave unset only if you intentionally allow any email.
EXPO_PUBLIC_CLOUD_OWNER_EMAIL=you@example.com
