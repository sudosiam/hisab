# Copy to `.env` for local builds. Values are public (anon key) but must match your project.
# For EAS: set the same names as project secrets / env vars on preview + production profiles.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Personal single-user lock (client UX only). Must match the owner email in
# supabase/cloud-backup-setup.sql (section 0 trigger) — that trigger is the real
# server-side gate. Leave unset only if you intentionally allow any email client-side.
EXPO_PUBLIC_CLOUD_OWNER_EMAIL=you@example.com
